# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
jupyter/

# --- Data (too large / licensed, keep manifests only) ---
# Scoped to data/ only: app assets under android/ MUST stay committable.
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep
data/splits/*.png
data/**/*.{jpg,jpeg,png,webp,mp4,bmp,gif}
labeling/cache/

# --- Models (artifacts are regenerated by ml/) ---
models/**/*.tflite
models/**/*.onnx
models/**/*.h5
models/**/*.keras
models/**/*.pb
models/**/*.bin
models/**/*.npz
!models/.gitkeep

# --- Android / Gradle ---
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/externalNativeBuild/
*.apk
*.aab

# --- Reports regenerated at runtime ---
ml/reports/**/*.html

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
