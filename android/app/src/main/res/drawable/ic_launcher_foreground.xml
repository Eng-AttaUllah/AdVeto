<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground — vector conversion of docs/logo.svg.

  Shield + covered banner band, kept inside the adaptive-icon safe zone
  (a 66dp circle centred in the 108dp canvas) so no launcher mask clips it.
  minSdk is 29, which is >= 26, so mipmap-anydpi-v26 resolves on every
  supported device and no density-specific PNG fallbacks are needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield -->
    <path
        android:fillColor="#E6EDF3"
        android:pathData="M54,26 L79,35 C79,57 70,72 54,82 C38,72 29,57 29,35 Z" />

    <!-- The vetoed advertisement band -->
    <path
        android:fillColor="#F59E0B"
        android:pathData="M36,52 h36 v10 h-36 z" />
</vector>
