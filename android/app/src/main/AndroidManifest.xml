<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Stage (1) capture — MediaProjection requires an explicit user consent
      dialog at runtime; it is never granted at install time. From API 34 the
      capture must run inside a foreground service of type `mediaProjection`.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Stage (6) overlay — drawn over other applications' advertisements. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground-service notification (mandatory from API 33). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Stage (7) — record which application produced an ad. UsageStats is used
      rather than QUERY_ALL_PACKAGES so the sideloaded prototype does not
      declare a permission the platform treats as sensitive.

      ML Kit text recognition (stage 3b) is added in Batch 2c.
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdVeto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage (7) — read-only aggregation over the event log. -->
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false" />

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Draws the cover over an advertisement region (stage 6). -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false" />
    </application>

</manifest>
